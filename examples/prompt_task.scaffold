artifact DraftAnswer = {
    answer: string,
}

type AnswerOutput = {
    answer: string,
}

prompt answer_question {
    input: { question: string, tone: string }
    output: DraftAnswer
    template: "Question: {question}\nRespond in a {tone} tone with a short factual answer."
}

task answer_question {
    input: { question: string, tone: string }
    output: AnswerOutput

    artifacts {
        draft: DraftAnswer
    }

    stage write using prompt answer_question {
        in: input
        out: draft
    }

    emit {
        answer: draft.answer
    }
}

harness baseline for task answer_question {
    defaults {
        model: "gpt-5-mini"
    }

    bind write {
        temperature: 0.2
        system_prompt: "You answer directly, avoid filler, and keep the response grounded in the question."
    }
}

objective answer_quality for task answer_question {
    dataset: [
        { id: "capital-france", input: { question: "What is the capital of France?", tone: "calm" }, expected: { answer: "Paris" } },
        { id: "capital-japan", input: { question: "What is the capital of Japan?", tone: "neutral" }, expected: { answer: "Tokyo" } },
    ]
    harness: baseline
    repeats: 1
    metric non_empty = len(output.answer) > 0
    metric exact_match = output.answer == expected.answer
    score = exact_match
    select {
        primary: exact_match
        tie_breakers: [non_empty]
    }
}

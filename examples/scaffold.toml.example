# Scaffold Configuration Example
# Copy this to ~/.scaffold/config.toml or ./scaffold.toml

# Default model to use when not specified
default_model = "gpt-4o-mini"

# Enable verbose logging
verbose = false

# LLM Provider Configuration
[llm.openai]
# API key (can also use OPENAI_API_KEY env var)
api_key = "sk-..."

# Optional: custom base URL (for Azure OpenAI, proxies, etc.)
# base_url = "https://api.openai.com/v1"

# Default model for OpenAI
default_model = "gpt-4o"

# Default temperature
temperature = 0.7

# Max tokens
max_tokens = 4096

[llm.anthropic]
# API key (can also use ANTHROPIC_API_KEY env var)
api_key = "sk-ant-..."

# Default model for Anthropic
default_model = "claude-3-sonnet-20240229"

# Temperature
temperature = 0.7

# Max tokens
max_tokens = 4096

# Custom providers (e.g., local models via ollama)
[llm.providers.ollama]
base_url = "http://localhost:11434/v1"
default_model = "llama3"

artifact TextStats = {
    cleaned: string,
    words: int,
}

type InspectOutput = {
    cleaned: string,
    words: int,
}

tool normalize_plain {
    input: { text: string }
    output: string
    impl: shell("printf '%s' '{text}' | tr '\\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'")
}

tool normalize_loud {
    input: { text: string }
    output: string
    impl: shell("printf '%s' '{text}' | tr '[:lower:]' '[:upper:]' | tr '\\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'")
}

tool word_count {
    input: { text: string }
    output: int
    impl: shell("printf '%s' '{text}' | wc -w | tr -d ' '")
}

task inspect_text {
    input: { text: string }
    output: InspectOutput

    artifacts {
        cleaned: string
        words: int
    }

    stage normalize using tool normalize_plain {
        in: input
        out: cleaned
    }

    stage count using tool word_count {
        in: { text: cleaned }
        out: words
    }

    emit {
        cleaned: cleaned
        words: words
    }
}

harness search_component for task inspect_text {
    tune {
        normalize.component in components()
    }
}

objective uppercase_cleaning for task inspect_text {
    dataset: [
        {
            id: "loud-cleaning",
            input: { text: "hello  world" },
            expected: { cleaned: "HELLO WORLD", words: 2 }
        }
    ]
    harness: search_component
    repeats: 1
    constraint clean_present = len(output.cleaned) > 0
    checker exact_cleaned = output.cleaned == expected.cleaned
    metric word_match = output.words == expected.words
    score = exact_cleaned
    select {
        primary: exact_cleaned
        tie_breakers: [word_match]
    }
}

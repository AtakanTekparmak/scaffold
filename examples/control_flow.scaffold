// Control Flow Example - for/while loops and if conditions in tools

type Numbers = {
    items: list<int>,
    total: int
}

type ProcessResult = {
    processed: list<string>,
    count: int
}

// Tool with for loop - sums numbers
tool sum_numbers {
    input: { numbers: list<int> }
    output: int

    impl: sequence {
        let total = 0
        for num in input.numbers {
            let total = total + num
        }
    }
}

// Tool with while loop - counts down
tool countdown {
    input: { start: int }
    output: int

    impl: sequence {
        let count = input.start
        while count > 0 {
            let count = count - 1
        }
    }
}

// Tool with if/else conditions
tool categorize {
    input: { value: int }
    output: string

    impl: if input.value > 100 {
        "large"
    } else {
        if input.value > 10 {
            "medium"
        } else {
            "small"
        }
    }
}

// Tool with nested loops
tool nested_example {
    input: { outer: int, inner: int }
    output: int

    impl: sequence {
        let sum = 0
        let i = 0
        while i < input.outer {
            let j = 0
            while j < input.inner {
                let sum = sum + 1
                let j = j + 1
            }
            let i = i + 1
        }
    }
}

// Tool with infinite loop and break
tool process_until_done {
    input: { max_iterations: int }
    output: int

    impl: sequence {
        let count = 0
        loop {
            let count = count + 1
            if count >= input.max_iterations {
                break
            }
        }
    }
}

// Tool with loop and continue (skips certain iterations)
tool skip_example {
    input: { limit: int }
    output: int

    impl: sequence {
        let sum = 0
        let i = 0
        while i < input.limit {
            let i = i + 1
            // Skip values less than 5
            if i < 5 {
                continue
            }
            let sum = sum + i
        }
    }
}

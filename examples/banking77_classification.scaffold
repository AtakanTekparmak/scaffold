artifact IntentPrediction = {
    label: string,
}

type Banking77Output = {
    label: string,
}

tool normalize_intent_label {
    input: { label: string }
    output: string
    impl: shell("printf '%s' '{label}' | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/_/g; s/__*/_/g; s/^_//; s/_$//'")
}

prompt classify_banking_intent {
    input: { text: string, label_guide: string, labels: list<string> }
    output: IntentPrediction
    template: file("prompts/banking77_classifier/naive.txt")
}

task classify_banking_intent {
    input: { text: string, label_guide: string, labels: list<string> }
    output: Banking77Output

    artifacts {
        raw_prediction: IntentPrediction
        normalized_label: string
    }

    stage classify using prompt classify_banking_intent {
        in: input
        out: raw_prediction
    }

    stage normalize using tool normalize_intent_label {
        in: { label: raw_prediction.label }
        out: normalized_label
    }

    emit {
        label: normalized_label
    }
}

harness banking77_search for task classify_banking_intent {
    defaults {
        model: "gpt-4o-mini"
    }

    bind classify {
        variant: variant("banking77_classifier", "naive")
        system_prompt: variant("banking77_system", "baseline")
        temperature: 0.0
    }

    tune {
        classify.model in ["gpt-4o-mini", "gpt-5-mini"]
        classify.variant in variants("banking77_classifier")
        classify.system_prompt in [
            variant("banking77_system", "baseline"),
            variant("banking77_system", "strict"),
            variant("banking77_system", "disambiguate")
        ]
        classify.temperature in [0.0, 0.2]
    }
}

objective banking77_subset_accuracy for task classify_banking_intent {
    dataset: file("datasets/banking77_subset.jsonl")
    harness: banking77_search
    repeats: 1
    constraint known_label = contains(input.labels, output.label)
    checker exact_label = output.label == expected.label
    metric non_empty = len(output.label) > 0
    score = exact_label
    split {
        train: 0.5
        val: 0.25
        test: 0.25
    }
    select {
        primary: exact_label
        tie_breakers: [non_empty]
    }
}

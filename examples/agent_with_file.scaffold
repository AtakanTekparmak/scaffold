// Agent Example with External System Prompt
// Demonstrates using file() to load system prompt from external file
//
// Legacy pre-task example:
//   this file still uses the older agent-only execution model and needs a task wrapper
//   before it can run through the current CLI surface.

type Answer = {
    answer: string,
    confidence: string,
    sources: list<string>
}

// Tool for word counting
tool word_count {
    input: { text: string }
    output: { count: int }
    impl: shell("echo '{text}' | wc -w | tr -d ' '")
}

// Tool for extracting hashtags
tool extract_hashtags {
    input: { text: string }
    output: { hashtags: list<string> }
    impl: shell("echo '{text}' | grep -o '#[a-zA-Z0-9_]*' || echo ''")
}

// Agent with system prompt loaded from file
agent researcher {
    input: { question: string }
    output: Answer

    tools: [word_count, extract_hashtags]

    // System prompt loaded from external markdown file
    system: file("prompts/researcher.md")

    max_turns: 5
}

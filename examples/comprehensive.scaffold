// Comprehensive Example - Demonstrates ALL working scaffold DSL features
// This is the reference example for the full language specification
//
// NOTE: Foreign function calls (module::func()) are defined in IR but not fully
// supported in the parser inside let bindings yet. See ffi_example.scaffold
// for the planned syntax.

// =============================================================================
// TYPE DEFINITIONS
// =============================================================================

// Simple type alias
type Score = float

// Struct types
type DocumentInfo = {
    title: string,
    word_count: int,
    char_count: int,
    quality_score: Score
}

type AnalysisConfig = {
    max_length: int,
    include_metadata: bool,
    output_format: string
}

type ProcessingResult = {
    success: bool,
    data: option<string>,
    errors: list<string>,
    metrics: map<string, float>
}

type ValidationResult = {
    valid: bool,
    issues: list<string>
}

// =============================================================================
// TOOLS - Basic implementations
// =============================================================================

// Simple tool with shell command
tool count_words {
    input: { text: string }
    output: { count: int }
    impl: shell("echo '{text}' | wc -w | tr -d ' '")
}

// Another shell tool
tool count_chars {
    input: { text: string }
    output: { count: int }
    impl: shell("echo -n '{text}' | wc -c | tr -d ' '")
}

// Tool that calls another tool
tool analyze_document {
    input: { content: string }
    output: { words: int, chars: int }

    impl: sequence {
        let word_result = count_words(input.content)
        let char_result = count_chars(input.content)
    }
}


// =============================================================================
// TOOLS - Control Flow: If/Else
// =============================================================================

tool classify_length {
    input: { count: int }
    output: string

    impl: if input.count > 100 {
        "long"
    } else {
        if input.count > 20 {
            "medium"
        } else {
            "short"
        }
    }
}

// Nested if/else with different return paths
tool grade_score {
    input: { score: float }
    output: { grade: string, passed: bool }

    impl: if input.score >= 90.0 {
        let grade = "A"
        let passed = true
    } else {
        if input.score >= 80.0 {
            let grade = "B"
            let passed = true
        } else {
            if input.score >= 70.0 {
                let grade = "C"
                let passed = true
            } else {
                let grade = "F"
                let passed = false
            }
        }
    }
}

// =============================================================================
// TOOLS - Control Flow: For Loops
// =============================================================================

tool sum_numbers {
    input: { numbers: list<int> }
    output: { total: int, count: int }

    impl: sequence {
        let total = 0
        let count = 0
        for num in input.numbers {
            let total = total + num
            let count = count + 1
        }
    }
}

tool process_items {
    input: { items: list<string> }
    output: { processed: int }

    impl: sequence {
        let processed = 0
        for item in input.items {
            let processed = processed + 1
        }
    }
}

// =============================================================================
// TOOLS - Control Flow: While Loops
// =============================================================================

tool countdown {
    input: { start: int }
    output: { iterations: int }

    impl: sequence {
        let count = input.start
        let iterations = 0
        while count > 0 {
            let count = count - 1
            let iterations = iterations + 1
        }
    }
}

tool iterate_until {
    input: { target: int }
    output: { reached: bool, steps: int }

    impl: sequence {
        let current = 0
        let steps = 0
        while current < input.target {
            let current = current + 1
            let steps = steps + 1
        }
        let reached = true
    }
}

// =============================================================================
// TOOLS - Control Flow: Nested Loops
// =============================================================================

tool matrix_sum {
    input: { rows: int, cols: int }
    output: { total: int }

    impl: sequence {
        let total = 0
        let i = 0
        while i < input.rows {
            let j = 0
            while j < input.cols {
                let total = total + 1
                let j = j + 1
            }
            let i = i + 1
        }
    }
}

// =============================================================================
// TOOLS - Control Flow: Loop with Break/Continue
// =============================================================================

tool find_limit {
    input: { max: int }
    output: { found_at: int }

    impl: sequence {
        let i = 0
        loop {
            let i = i + 1
            if i >= input.max {
                break
            }
        }
        let found_at = i
    }
}

tool skip_small {
    input: { limit: int, threshold: int }
    output: { sum: int }

    impl: sequence {
        let sum = 0
        let i = 0
        while i < input.limit {
            let i = i + 1
            if i < input.threshold {
                continue
            }
            let sum = sum + i
        }
    }
}

// =============================================================================
// TOOLS - Specifications (pre/post conditions)
// =============================================================================

tool safe_divide {
    input: { a: int, b: int }
    output: { quotient: int }

    spec {
        pre: input.b != 0
        post: output.quotient * input.b <= input.a
        pure: true
    }

    impl: sequence {
        let quotient = input.a / input.b
    }
}

tool bounded_value {
    input: { value: int, min: int, max: int }
    output: { clamped: int, was_clamped: bool }

    spec {
        pre: input.min <= input.max
        post: output.clamped >= input.min && output.clamped <= input.max
        pure: true
    }

    impl: if input.value < input.min {
        let clamped = input.min
        let was_clamped = true
    } else {
        if input.value > input.max {
            let clamped = input.max
            let was_clamped = true
        } else {
            let clamped = input.value
            let was_clamped = false
        }
    }
}

// =============================================================================
// TOOLS - Variants (alternative implementations)
// =============================================================================

tool compute_distance {
    input: { x1: int, y1: int, x2: int, y2: int }
    output: { distance: int, method: string }

    // Default: Manhattan distance
    impl: sequence {
        let dx = input.x2 - input.x1
        let dy = input.y2 - input.y1
        let distance = dx + dy
        let method = "manhattan"
    }

    variants {
        // Chebyshev distance (max of deltas) - uses conditional logic
        chebyshev: if input.x2 - input.x1 > input.y2 - input.y1 {
            let distance = input.x2 - input.x1
            let method = "chebyshev"
        } else {
            let distance = input.y2 - input.y1
            let method = "chebyshev"
        }

        // Simple sum (for comparison)
        simple: sequence {
            let distance = input.x1 + input.y1 + input.x2 + input.y2
            let method = "simple"
        }
    }
}

// =============================================================================
// TOOLS - Parallel Execution
// =============================================================================

tool parallel_counts {
    input: { text: string }
    output: { word_count: int, char_count: int }

    impl: parallel {
        let words = count_words(input.text)
        let chars = count_chars(input.text)
    }
}

// =============================================================================
// PROMPTS - Basic
// =============================================================================

prompt summarize {
    input: { text: string, max_words: int }
    output: { summary: string }
    template: "Summarize the following text in at most {max_words} words:\n\n{text}"
}

// Prompt with system message
prompt classify_text {
    input: { text: string }
    output: { category: string, confidence: float }
    system: "You are a text classifier. Always respond with valid JSON containing 'category' and 'confidence' fields."
    template: "Classify this text into one of: technical, business, creative, personal.\n\nText: {text}"
}

// Prompt for structured extraction
prompt extract_entities {
    input: { document: string }
    output: { entities: list<string>, count: int }
    system: "Extract named entities from text. Return JSON with 'entities' array and 'count'."
    template: "Extract all named entities (people, places, organizations) from:\n\n{document}"
}

// =============================================================================
// AGENTS - Basic (no tools)
// =============================================================================

agent simple_qa {
    input: { question: string }
    output: { answer: string }
    tools: []
    system: "You are a helpful assistant. Answer questions concisely and accurately."
    max_turns: 3
}

// =============================================================================
// AGENTS - With Tools
// =============================================================================

agent document_analyzer {
    input: { document: string }
    output: { analysis: string, word_count: int, category: string }

    tools: [count_words, count_chars, classify_length]

    system: "You are a document analysis assistant. Use the available tools to analyze documents.
First count words and characters, then classify the length, then provide your analysis."

    max_turns: 5
}

// =============================================================================
// AGENTS - With Reward and Done Conditions (for RL)
// =============================================================================

agent iterative_writer {
    input: { topic: string, target_words: int }
    output: { content: string, final_word_count: int }

    tools: [count_words]

    system: "You are a writing assistant. Write about the given topic.
Use the count_words tool to check your progress toward the target word count.
Keep writing until you reach the target."

    max_turns: 10

    // Dense reward: progress toward target (for RL training)
    reward: final_word_count / target_words

    // Done when we hit the target
    done: final_word_count >= target_words
}

// =============================================================================
// AGENTS - Error Handling
// =============================================================================

agent robust_analyzer {
    input: { data: string }
    output: { output_result: string, status: string }

    tools: [count_words, count_chars]

    system: "Analyze the given data. If any tool fails, try a different approach."

    max_turns: 5

    // Retry on errors instead of failing immediately
    on_error: retry(3)

    // Timeout after 60 seconds
    timeout: 60
}

agent strict_processor {
    input: { input_text: string }
    output: { processed: string }

    tools: [count_words]

    system: "Process the input text. Fail immediately if anything goes wrong."

    max_turns: 3

    // Abort on first error (explicit default)
    on_error: abort

    timeout: 30
}

// =============================================================================
// PIPELINES - Basic Sequential
// =============================================================================

pipeline text_stats {
    input: { text: string }
    output: { words: int, chars: int, length_class: string }

    steps {
        let word_result = count_words(text)
        let char_result = count_chars(text)
        let words = word_result.count
        let chars = char_result.count
        let length_class = classify_length(words)
    }
}

// =============================================================================
// PIPELINES - With Multiple Steps
// =============================================================================

pipeline full_analysis {
    input: { document: string }
    output: { words: int, chars: int, length_class: string }

    steps {
        // Step 1: Get word count
        let word_result = count_words(document)

        // Step 2: Get char count
        let char_result = count_chars(document)

        // Step 3: Classify by length
        let words = word_result.count
        let chars = char_result.count
        let length_class = classify_length(words)
    }
}

// =============================================================================
// PIPELINES - With Reward (for RL optimization)
// =============================================================================

pipeline optimized_processing {
    input: { text: string, quality_threshold: float }
    output: { words: int, chars: int, length_class: string }

    steps {
        // Analyze text
        let word_result = count_words(text)

        // Get char count
        let char_result = count_chars(text)

        // Classify by length
        let words = word_result.count
        let chars = char_result.count
        let length_class = classify_length(words)
    }
}

// =============================================================================
// PIPELINES - Orchestration (conditional routing)
// =============================================================================

pipeline smart_router {
    input: { request: string }
    output: { words: int, length_class: string }

    steps {
        // Get word count
        let word_result = count_words(request)
        let words = word_result.count

        // Classify by length
        let length_class = classify_length(words)
    }
}

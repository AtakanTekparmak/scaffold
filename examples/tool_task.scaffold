artifact TextStats = {
    cleaned: string,
    words: int,
    chars: int,
}

type InspectOutput = {
    cleaned: string,
    words: int,
    chars: int,
}

tool normalize_text {
    input: { text: string }
    output: string
    impl: shell("printf '%s' '{text}' | tr '\\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'")

    variants {
        loud: shell("printf '%s' '{text}' | tr '[:lower:]' '[:upper:]' | tr '\\n' ' ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'")
    }
}

tool word_count {
    input: { text: string }
    output: int
    impl: shell("printf '%s' '{text}' | wc -w | tr -d ' '")
}

tool char_count {
    input: { text: string }
    output: int
    impl: shell("printf '%s' '{text}' | wc -c | tr -d ' '")
}

tool inspect_text {
    input: { text: string }
    output: TextStats
    impl: sequence {
        let cleaned = text
        let words = word_count(cleaned)
        let chars = char_count(cleaned)
    }
}

task inspect_text {
    input: { text: string }
    output: InspectOutput

    artifacts {
        cleaned: string
        stats: TextStats
    }

    stage normalize using tool normalize_text {
        in: input
        out: cleaned
    }

    stage inspect using tool inspect_text {
        in: { text: cleaned }
        out: stats
    }

    emit {
        cleaned: stats.cleaned
        words: stats.words
        chars: stats.chars
    }
}

harness loud_text for task inspect_text {
    bind normalize {
        variant: "normalize_text::loud"
    }
}

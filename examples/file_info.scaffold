// File info scaffold - demonstrates shell tool usage (no API keys needed)
//
// Test individual tools:
//   scaffold run examples/file_info.scaffold --tool get_size --input '{"path": "Cargo.toml"}'
//   scaffold run examples/file_info.scaffold --tool count_lines --input '{"path": "Cargo.toml"}'
//   scaffold run examples/file_info.scaffold --tool get_type --input '{"path": "Cargo.toml"}'
//   scaffold run examples/file_info.scaffold --tool file_summary --input '{"path": "Cargo.toml"}'

type FileInput = { path: string }

// Get file size in bytes
tool get_size {
    input: { path: string }
    output: string
    impl: shell("wc -c < {path} | tr -d ' '")
}

// Count lines in file
tool count_lines {
    input: { path: string }
    output: string
    impl: shell("wc -l < {path} | tr -d ' '")
}

// Get file type
tool get_type {
    input: { path: string }
    output: string
    impl: shell("file -b {path}")
}

// Get a summary of the file (single shell command)
tool file_summary {
    input: { path: string }
    output: string
    impl: shell("echo 'File: {path}' && echo 'Size:' $(wc -c < {path}) 'bytes' && echo 'Lines:' $(wc -l < {path}) && echo 'Type:' $(file -b {path})")
}

// Agent to analyze a file
agent file_analyzer {
    input: FileInput
    output: { summary: string }
    tools: [get_size, count_lines, get_type, file_summary]
    system: "You analyze files and provide summaries. Use the available tools to gather information."
    max_turns: 3
}
